{
  "name": "@featul/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test src"
  },
  "exports": {
