      "types": "./src/protocol.ts"
    },
    "./source": {
      "import": "./src/source.ts",
      "types": "./src/source.ts"
    }
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@featul/tsconfig": "workspace:*",
    "bun-types": "^1.3.0",
    "typescript": "^5.9.2"
  }
}
