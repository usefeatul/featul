{
  "name": "featul",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "app:dev": "turbo run dev --filter=app",
    "feed:dev": "turbo run dev --filter=feed",
    "web:dev": "turbo run dev --filter=web",
    "db:generate": "turbo run db:generate --filter=@featul/db",
    "db:migrate": "turbo run db:migrate --filter=@featul/db",
    "db:push": "turbo run db:push --filter=@featul/db",
    "db:studio": "turbo run db:studio --filter=@featul/db",
    "db:set-dev-plan": "turbo run db:set-dev-plan --filter=@featul/db",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "bun test packages/api/src apps/app/tests && bun test --preload ./tests/security/setup.ts tests/security && bun test tests/ai",
    "release:check": "bun packages/api/scripts/readiness.ts",
    "test:integration": "bun test tests/integration"
  },
  "devDependencies": {
    "@featul/tsconfig": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "5.7.3"
  },
  "overrides": {
    "better-auth": "1.7.7",
    "@better-auth/core": "1.7.7",
    "postcss-selector-parser": "7.1.6",
    "esbuild": "0.28.1",
    "dompurify": "3.4.17",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "rehype-highlight": "^7.0.2"
  }
}
