# Written by install.sh. To set up by hand: copy to .env, fill in the required block,
# then `docker compose up -d --build`. Rebuild after changing FEATUL_DOMAIN.

# ── Required ─────────────────────────────────────────────────────────────────
# The app runs at https://FEATUL_DOMAIN and workspaces at https://{slug}.FEATUL_DOMAIN.
# Point an A record for FEATUL_DOMAIN and *.FEATUL_DOMAIN at this server.
FEATUL_DOMAIN=feedback.example.com
# Let's Encrypt account email for certificate notices.
ACME_EMAIL=you@example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_TOKEN=
BETTER_AUTH_SECRET=
CRON_SECRET=
NOTRA_CREDENTIALS_ENCRYPTION_KEY=

# ── Email (recommended) ──────────────────────────────────────────────────────
# Without a key, sign-in codes and invite links are printed to `docker compose logs app`.
RESEND_API_KEY=
RESEND_FROM="Featul <feedback@example.com>"

# ── Optional sign-in providers ───────────────────────────────────────────────
# Uncomment to enable. Callback URLs: https://FEATUL_DOMAIN/api/auth/callback/google (or /github)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Optional file uploads (any S3-compatible store) ──────────────────────────
# Uncomment to enable. Set R2_ENDPOINT for MinIO, Backblaze B2, etc., or R2_ACCOUNT_ID for
# Cloudflare R2. R2_PRIVATE_BUCKET must be a separate bucket with public access off.
# R2_ENDPOINT=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_BASE_URL=

# ── Optional AI features (changelog writer, voice typing) ────────────────────
# OPENROUTER_API_KEY=
