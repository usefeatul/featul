{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "crons": [
    {
      "path": "/api/cron/gc",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/changelog",
      "schedule": "* * * * *"
    }
  ],
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then bun ../../packages/api/scripts/readiness.ts; fi && bun run build"
}
