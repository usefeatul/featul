NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=replace_with_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
AUTH_COOKIE_DOMAIN=featul.com
AUTH_TRUSTED_ORIGINS=https://featul.com,https://app.featul.com,https://*.featul.com
BETTER_AUTH_SECRET=replace_with_secure_random
SENTRY_AUTH_TOKEN=replace_with_secure_random

# Rate limiting
UPSTASH_REDIS_REST_URL=replace_with_secure_random
UPSTASH_REDIS_REST_TOKEN=replace_with_secure_random
RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_ENABLED=false
AUTH_RATE_LIMIT_ENABLED=false

# OpenRouter
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_STREAM_MODEL=google/gemini-2.0-flash-001
OPENROUTER_APP_NAME=Featul
OPENROUTER_REFERER=https://app.featul.com

# R2 (object storage)
R2_ACCOUNT_ID=replace_with_secure_random
R2_ACCESS_KEY_ID=replace_with_secure_random
R2_SECRET_ACCESS_KEY=replace_with_secure_random
R2_BUCKET=replace_with_secure_random
R2_PUBLIC_BASE_URL=replace_with_secure_random
CRON_SECRET=replace_with_secure_random
STORAGE_ORPHAN_GC_MAX_AGE_DAYS=7
STORAGE_ORPHAN_GC_MAX_DELETES=200

# GitHub App integration
GITHUB_APP_ID=replace_with_github_app_id
GITHUB_APP_PRIVATE_KEY=replace_with_github_app_private_key_pem
# Set one of the following:
GITHUB_APP_SLUG=replace_with_github_app_slug
# GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITHUB_SETUP_STATE_SECRET=replace_with_long_random_secret

# Notra credential encryption
NOTRA_CREDENTIALS_ENCRYPTION_KEY=replace_with_long_random_secret

# Passkeys
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Featul
PASSKEY_ORIGIN=http://localhost:3000

# Widget (local / staging / production)
# Local: NEXT_PUBLIC_APP_URL=http://localhost:3000
# Staging: NEXT_PUBLIC_APP_URL=https://staging.featul.com
# Production: NEXT_PUBLIC_APP_URL=https://app.featul.com
# FEATUL_WIDGET_SECRET is for YOUR product server (identify signatures), not Featul.
FEATUL_WIDGET_SECRET=replace_with_workspace_signing_secret
NEXT_PUBLIC_WIDGET_TEST_PROJECT_ID=replace_with_workspace_id
# Optional: allow a localhost parent to load a staging/production widget iframe
# WIDGET_ALLOW_LOCALHOST=true

# Stripe billing
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_PRICE_ID_STARTER_MONTHLY=replace_with_stripe_starter_monthly_price_id
STRIPE_PRICE_ID_STARTER_YEARLY=replace_with_stripe_starter_yearly_price_id
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY=replace_with_stripe_professional_monthly_price_id
STRIPE_PRICE_ID_PROFESSIONAL_YEARLY=replace_with_stripe_professional_yearly_price_id

# Local paid-plan testing (development only — never commit real user data)
DEV_PLAN_OVERRIDE=true
DEV_PLAN=professional
DEV_PLAN_USER_ID=replace_with_user_id
DEV_PLAN_USER_EMAIL=replace_with_user_email
# DEV_PLAN_WORKSPACE_ID=replace_with_workspace_id
